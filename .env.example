GOOGLE_APPLICATION_CREDENTIALS=../your-credentials-file.json (local path to your service account key file)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id" (your GCP project ID)
# ------------------------
AUTH_username="your-username"
AUTH_password="your-password"
# ------------------------
# Frontend Cloud Run URL (for backend CORS) — update after first frontend deploy
ALLOWED_ORIGINS="https://your-frontend-url"
# ------------------------
# Stable secret used to HMAC-sign stateless session cookies. MUST be identical
# across all instances and kept secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET="your-random-secret"
SESSION_MAX_AGE=3600
